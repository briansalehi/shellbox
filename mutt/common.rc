set use_from = yes
set editor = "nvim"
set edit_headers = yes
set charset = UTF-8
set metoo = yes
set copy = no
set use_threads = threads
set sort = reverse-last-date-received
set sort_aux = date
set move = no
set pager_stop = yes
set smart_wrap = yes
set pipe_split = yes

unset use_domain
unset resolve

# imap
set timeout = 10
set mail_check = 10
set imap_keepalive = 300
set imap_idle = yes
set imap_check_subscribed = yes
set check_mbox_size = yes
set imap_pipeline_depth = 50

# sidebar
set sidebar_visible
set sidebar_format = "%B%<F? [%F]>%* %<N?%N/>%S"

# key bindings
bind index G imap-fetch-mail
bind index \cj next-unread
bind index \ck previous-unread
bind index P purge-message
bind index,pager \ci sidebar-prev
bind index,pager \cu sidebar-next
bind index,pager \co sidebar-open
bind index,pager \en search-opposite

# cache
set header_cache_backend = lmdb
set header_cache =~/.config/mutt/cache/headers
set message_cachedir =~/.config/mutt/cache/bodies
set certificate_file =~/.config/mutt/certificates

# w3m
auto_view text/html text/calendar
alternative_order text/calendar text/plain text/enriched text/html
set mailcap_path = ~/.config/mutt/mailcap

# gitlab, jira, playbook and ultratronik mails
subjectrx '\[Extern\] *' '%L%R'
message-hook . 'unset display_filter; unset allow_ansi; reset quote_regex; set mailcap_path = ~/.config/mutt/mailcap; unalternative_order *; alternative_order text/calendar text/plain text/enriched text/html'
message-hook '~f @info.kununu.com' 'unalternative_order *; alternative_order text/calendar text/html'
message-hook '~f gitlab@u-experten.de' 'set display_filter = ~/.config/mutt/filters/gitlab; set allow_ansi; set quote_regex = "^$"'
message-hook '~f jira@u-experten.atlassian.net' 'set display_filter = ~/.config/mutt/filters/jira; set allow_ansi; set quote_regex = "^$"'
message-hook '~f @ultratronik.de' 'set mailcap_path = ~/.config/mutt/filters/ultratronik.mailcap; set display_filter = ~/.config/mutt/filters/ultratronik'
message-hook '~f jbosch@ultratronik.de ~s "^What.s new in Software U"' 'set mailcap_path = ~/.config/mutt/filters/playbook.mailcap; set display_filter = ~/.config/mutt/filters/playbook; set allow_ansi; set quote_regex = "^$"'

# urlscan
set wait_key = no
macro index,pager \cb "<enter-command>set pipe_decode; setenv MUTT_FULL_LINKS 1<enter><pipe-message>urlscan -d -W<enter><enter-command>unset pipe_decode; unsetenv MUTT_FULL_LINKS<enter>" "call urlscan to extract URLs out of a message"
macro attach,compose \cb "<pipe-entry>urlscan -d -W<enter>" "call urlscan to extract URLs out of a message"

# notifications
set new_mail_command = "notify-send --transient --icon=mail-unread --urgency=normal 'Neomutt' '%n new emails in %f' &"
