set use_from = yes
set editor = "nvim"
set edit_headers = yes
set charset = UTF-8
set metoo = yes
set copy = no
set sort = threads
set sort_aux = reverse-last-date-received
set move = no
set pager_stop = yes
set smart_wrap = yes
set pipe_split = yes

unset use_domain
unset resolve

# imap
set timeout = 10
set mail_check = 10
set imap_keepalive = 300
set imap_idle = yes
set imap_check_subscribed = yes
set check_mbox_size = yes
set imap_pipeline_depth = 50

# sidebar
set sidebar_visible
set sidebar_format = "%B%<F? [%F]>%* %<N?%N/>%S"

# key bindings
bind index G imap-fetch-mail
bind index \cj next-unread
bind index \ck previous-unread
bind index P purge-message
bind index,pager \ci sidebar-prev
bind index,pager \cu sidebar-next
bind index,pager \co sidebar-open

# cache
set header_cache_backend = lmdb
set header_cache =~/.config/mutt/cache/headers
set message_cachedir =~/.config/mutt/cache/bodies
set certificate_file =~/.config/mutt/certificates

# w3m
auto_view text/html
alternative_order text/plain text/enriched text/html
set mailcap_path = ~/.config/mutt/mailcap

# gitlab notifications
subjectrx '\[Extern\] *' '%L%R'
message-hook . 'unset display_filter; unset allow_ansi'
message-hook '~f gitlab@u-experten.de' 'set display_filter = ~/.config/mutt/gitlab-filter; set allow_ansi'

# urlscan
set wait_key = no
macro index,pager \cb "<pipe-message> urlscan<Enter>" "call urlscan to extract URLs out of a message"
macro attach,compose \cb "<pipe-entry> urlscan<Enter>" "call urlscan to extract URLs out of a message"

# notifications
set new_mail_command = "notify-send --icon=mail-unread --urgency=normal 'Neomutt' '%n new emails in %f' &"
